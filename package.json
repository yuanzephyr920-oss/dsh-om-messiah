{
  "name": "dsh-om-messiah",
  "version": "1.3.0",
  "type": "module",
  "description": "Rewrite every prompt into an Om Messiah prayer before it reaches the model, then choose prayer or original to send. Ships a Settings page.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/*.js": "./lib/*.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "screenshots.json",
    "docs/*.png",
    "docs/*.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prayer",
    "om-messiah",
    "om-messiah"
  ],
  "author": "yuanzephyr920-oss",
  "license": "MIT",
  "homepage": "https://github.com/yuanzephyr920-oss/dsh-mechanicus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuanzephyr920-oss/dsh-mechanicus.git"
  },
  "bugs": {
    "url": "https://github.com/yuanzephyr920-oss/dsh-mechanicus/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
